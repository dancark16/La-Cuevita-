# Copia este archivo como  .env  en el servidor y llénalo. Nunca lo subas a GitHub.

# ---- Sitio
DOMAIN=lacuevita.com
LETSENCRYPT_EMAIL=correo@lacuevita.com
FRONTEND_URL=https://lacuevita.com
HTTP_PORT=80
HTTPS_PORT=443
COOKIE_SECURE=true

# ---- Base de datos (elige una clave larga y propia)
POSTGRES_DB=tienda
POSTGRES_USER=tienda_user
POSTGRES_PASSWORD=

# ---- Sesiones: clave única de 32 caracteres o más (puedes generarla con:  openssl rand -base64 48)
JWT_SECRET=

# ---- Administrador inicial (se crea una sola vez; clave de 10 caracteres o más)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Inicio de sesión con Google
GOOGLE_CLIENT_ID=

# ---- Correo (facturas, envíos y recuperar contraseña). Gmail: smtp.gmail.com y "contraseña de aplicación"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Reglas de la tienda
ORDERS_ALLOW_DELETE=false
ORDER_RESERVATION_HOURS=48

# ---- Copias de seguridad
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=0
